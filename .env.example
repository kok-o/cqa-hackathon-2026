# Copy to .env at the repository root.
# The signed dataset link is supplied in the original organizer PDF.
CQA_DEV_URL=
CQA_DATA_DIR=data/raw
CQA_DATABASE_PATH=data/runtime/cqa.sqlite3
CQA_TEAM_NAME=SetW
# Optional: leave these empty to use import, checklist editing and history
# without sending any conversation to an AI service.
# OpenAI Responses: https://api.openai.com/v1; local servers can use Chat Completions.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_API_STYLE=responses
LLM_REASONING_EFFORT=max
LLM_TIMEOUT_SECONDS=600
LLM_CONCURRENCY=2
LLM_JSON_MODE=json_object
LLM_MAX_TOKENS=32768
# Optional USD prices from your provider's current tariff. Blank means unknown.
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
LLM_CACHED_INPUT_COST_PER_MILLION=
LLM_CACHE_WRITE_INPUT_COST_PER_MILLION=
